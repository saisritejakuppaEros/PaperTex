\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Qualitative example with two different reference sets for the same scene layout. The prompt-induced canvas and aligned depth map provide shared structural priors, while the reference images specify subject appearance. RefCompose generates semantically consistent composites for both reference configurations.}}{12}{figure.5}\protected@file@percent }
\newlabel{fig:multi_reference}{{5}{12}{Qualitative example with two different reference sets for the same scene layout. The prompt-induced canvas and aligned depth map provide shared structural priors, while the reference images specify subject appearance. RefCompose generates semantically consistent composites for both reference configurations}{figure.5}{}}
