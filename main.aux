\def\@LN@column{1}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Peak GPU memory (GB) at inference for varying reference count $N$ (batch size $1$; single H100; $1280 \times 720$). UNO~\cite  {wu2025uno} and XVerse~\cite  {xverse2024} are reference-image-based methods whose memory scales with the number of encoded references; both fail at $N{=}6$. RefCompose keeps memory approximately constant by canvas compression. OOM denotes out-of-memory failure.}}{13}{table.caption.14}\protected@file@percent }
\newlabel{tab:memory}{{1}{13}{Peak GPU memory (GB) at inference for varying reference count $N$ (batch size $1$; single H100; $1280 \times 720$). UNO~\cite {wu2025uno} and XVerse~\cite {xverse2024} are reference-image-based methods whose memory scales with the number of encoded references; both fail at $N{=}6$. RefCompose keeps memory approximately constant by canvas compression. OOM denotes out-of-memory failure}{table.caption.14}{}}
\newlabel{tab:memory@cref}{{[table][1][]1}{[1][13][]13}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Quantitative comparison on the Dense Layout test set~\cite  {xiang2025instanceassemble} ($5{,}000$ images; mean $8.3$ objects per image). Previous methods use five references per example because UNO and XVerse are not runnable beyond this setting on one H100; the $N{>}5$ RefCompose row evaluates the same model with additional references. Higher is better for all metrics. Reported values are means over the test set. \textbf  {Bold} denotes the best overall result; the improvement row compares RefCompose ($N{>}5$) only against the strongest reference-image baseline for each metric.}}{13}{table.caption.15}\protected@file@percent }
\newlabel{tab:quant_results}{{2}{13}{Quantitative comparison on the Dense Layout test set~\cite {xiang2025instanceassemble} ($5{,}000$ images; mean $8.3$ objects per image). Previous methods use five references per example because UNO and XVerse are not runnable beyond this setting on one H100; the $N{>}5$ RefCompose row evaluates the same model with additional references. Higher is better for all metrics. Reported values are means over the test set. \textbf {Bold} denotes the best overall result; the improvement row compares RefCompose ($N{>}5$) only against the strongest reference-image baseline for each metric}{table.caption.15}{}}
\newlabel{tab:quant_results@cref}{{[table][2][]2}{[1][13][]13}{}{}{}}
\@writefile{toc}{\contentsline {paragraph}{Comparison to token-based reference methods.}{13}{section*.17}\protected@file@percent }
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Qualitative comparison of RefCompose against CreatiLayout, InstanceAssemble, UNO, and XVerse across seven diverse multi-subject scenes, with ground truth in the leftmost column. Layout-conditioned baselines hallucinate subject appearance while token-based methods exhibit subject drift and loss of fine-grained detail under multi-object compositions. RefCompose consistently reproduces both spatial arrangement and photometric identity with the highest fidelity across all scene types.}}{14}{figure.caption.16}\protected@file@percent }
\newlabel{fig:teaser}{{4}{14}{Qualitative comparison of RefCompose against CreatiLayout, InstanceAssemble, UNO, and XVerse across seven diverse multi-subject scenes, with ground truth in the leftmost column. Layout-conditioned baselines hallucinate subject appearance while token-based methods exhibit subject drift and loss of fine-grained detail under multi-object compositions. RefCompose consistently reproduces both spatial arrangement and photometric identity with the highest fidelity across all scene types}{figure.caption.16}{}}
\newlabel{fig:teaser@cref}{{[figure][4][]4}{[1][13][]14}{}{}{}}
