\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Qualitative example with two different reference sets for the same scene layout. The prompt-induced canvas and aligned depth map provide shared structural priors, while the reference images specify subject appearance. RefCompose generates semantically consistent composites for both reference configurations.}}{16}{figure.caption.21}\protected@file@percent }
\newlabel{fig:multi_reference}{{5}{16}{Qualitative example with two different reference sets for the same scene layout. The prompt-induced canvas and aligned depth map provide shared structural priors, while the reference images specify subject appearance. RefCompose generates semantically consistent composites for both reference configurations}{figure.caption.21}{}}
\newlabel{fig:multi_reference@cref}{{[figure][5][]5}{[1][15][]16}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.6}Ablation Study}{16}{subsection.4.6}\protected@file@percent }
\newlabel{sec:ablation}{{4.6}{16}{Ablation Study}{subsection.4.6}{}}
\newlabel{sec:ablation@cref}{{[subsection][6][4]4.6}{[1][16][]16}{}{}{}}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Depth-controlled generation with identical reference assets. Changing only the depth map alters object orientation and scene dynamics---from a static sweet-shop arrangement to a chaotic environment with floating debris---while reference appearance remains stable.}}{17}{figure.caption.23}\protected@file@percent }
\newlabel{fig:orientation_control}{{6}{17}{Depth-controlled generation with identical reference assets. Changing only the depth map alters object orientation and scene dynamics---from a static sweet-shop arrangement to a chaotic environment with floating debris---while reference appearance remains stable}{figure.caption.23}{}}
\newlabel{fig:orientation_control@cref}{{[figure][6][]6}{[1][16][]17}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Ablation study isolating the contributions of the reference canvas and depth map prior on an indoor multi-object scene, with corresponding input reference crops shown below. Removing either component individually degrades subject identity or geometric coherence, manifesting as hallucinated textures or incorrect spatial placement respectively. The full model combining both conditioning signals achieves accurate appearance preservation and geometrically consistent composition, confirming their complementary necessity.}}{17}{figure.caption.24}\protected@file@percent }
\newlabel{fig:ablation}{{7}{17}{Ablation study isolating the contributions of the reference canvas and depth map prior on an indoor multi-object scene, with corresponding input reference crops shown below. Removing either component individually degrades subject identity or geometric coherence, manifesting as hallucinated textures or incorrect spatial placement respectively. The full model combining both conditioning signals achieves accurate appearance preservation and geometrically consistent composition, confirming their complementary necessity}{figure.caption.24}{}}
\newlabel{fig:ablation@cref}{{[figure][7][]7}{[1][16][]17}{}{}{}}
